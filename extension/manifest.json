{
  "manifest_version": 3,
  "name": "CC Quota Fetcher",
  "version": "0.1.0",
  "description": "Fetch claude.ai usage quota and push to local cache via native messaging",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "CC Quota Fetcher",
    "default_popup": "popup.html"
  },
  "permissions": [
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://api.deepseek.com/*",
    "https://platform.xiaomimimo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
